#!/usr/bin/env bash
# blazonry pre-commit: fast gates only (fmt + clippy). Full suite lives in
# `just check` / pre-push. Skip in an emergency with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Only gate when Rust or web-app sources are staged.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '\.rs$|^web-app/src/'; then
    exit 0
fi

if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    echo "pre-commit: cargo fmt --check"
    if ! cargo fmt --check 2>/dev/null; then
        echo "pre-commit: formatting drift — run 'cargo fmt' and re-commit." >&2
        exit 1
    fi

    echo "pre-commit: cargo clippy (deny warnings)"
    if ! cargo clippy --all-targets --quiet -- -D warnings 2>&1 | tail -30; then
        echo "pre-commit: clippy failed — fix warnings or run 'just clippy-fix'." >&2
        exit 1
    fi
fi

# Generated web bundle must match its source.
if printf '%s\n' "$staged" | grep -qE '^web-app/src/'; then
    if [ -d web-app/node_modules ]; then
        echo "pre-commit: verifying web bundle matches source"
        node web-app/build.js >/dev/null
        if ! git diff --quiet -- web/index.html web/sw.js; then
            echo "pre-commit: web/index.html or web/sw.js is stale — run 'node web-app/build.js' and re-commit." >&2
            exit 1
        fi
    else
        echo "pre-commit: web-app sources staged but node_modules missing — skipping bundle check (run 'just deps')." >&2
    fi
fi
